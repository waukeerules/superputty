<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">  
  <Package Name="SuperXPuTTY" Language="1033" Version="!(bind.fileVersion.ProductExe)" Manufacturer="SilverGreen93" UpgradeCode="03448e74-2381-4de9-93f0-58039c377caa" InstallerVersion="200">
    
    <Icon Id="ProductIcon" SourceFile="$(var.SuperPutty.ProjectDir)Apps-utilities-terminal.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/SilverGreen93/superputty/wiki/Documentation" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SilverGreen93/superputty/" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- AllowSameVersionUpgrades: every build is versioned from the exe (2.1.1.0), so without it a newer build of the
         same version installed alongside the old one and Windows Installer kept the old, same-versioned exe -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <Media Id="1" Cabinet="Cab1.cab" EmbedCab="yes" />
    
    <Feature Id="ProductFeature" Title="SuperXPuTTY" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="HighlightedOutputComponents" />
      <ComponentRef Id="ApplicationShortcuts" /> 
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <WixVariable Id="WixUIBannerBmp" Value="WixUIBannerBmp.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="WixUIDialogBmp.bmp" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.SolutionDir)License.rtf" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />      
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SuperXPuTTY" />    
    <Property Id="WixShellExecTarget" Value="[#ProductExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X86" />
  </Package>

  <Fragment>
      <StandardDirectory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="SuperXPuTTY" />
      </StandardDirectory>


      <StandardDirectory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuSubfolder" Name="SuperXPuTTY">
          <Component Id="ApplicationShortcuts" Guid="0CF406F3-901A-4C75-9DCB-BE6042BC70CE">

            <Shortcut Id="ApplicationShortcut1" Name="SuperXPuTTY" Description="SuperXPuTTY Terminal Window Manager" Target="[#ProductExe]" WorkingDirectory="INSTALLFOLDER" />

            <util:InternetShortcut Id="ProjectWebsiteShortcut" Name="Project Website" Target="https://github.com/SilverGreen93/superputty/" />

            <Shortcut Id="UninstallProduct" Name="Uninstall SuperXPuTTY" Target="[SystemFolder]msiexec.exe" Arguments="/x [ProductCode]" Description="Uninstalls SuperXPuTTY" />

            <RegistryValue Root="HKCU" Key="Software\SilverGreen93\SuperXPuTTY" Name="installed" Type="integer" Value="1" KeyPath="yes" />

            <RemoveFolder Id="ProgramMenuSubfolder" On="uninstall" />
          </Component>
        </Directory>
      </StandardDirectory>
    </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ProductExe">
        <File Id="ProductExe" Source="$(var.SuperPutty.TargetPath)">
          <netfx:NativeImage Id="ngen_ProductExe" Platform="all" Priority="3" />
        </File>
      </Component>
      <Component Id="ProductExeConfig">
        <File Id="___var.SuperPutty.TargetPath_.config" Source="$(var.SuperPutty.TargetPath).config" />
      </Component>
      <Component Id="ProductLibLogging">
        <File Id="log4net.dll" Source="$(var.SuperPutty.TargetDir)\log4net.dll" />
      </Component>
      <Component Id="ProductLibUI">
        <File Id="WeifenLuo.WinFormsUI.Docking.dll" Source="$(var.SuperPutty.TargetDir)\WeifenLuo.WinFormsUI.Docking.dll" />
      </Component>
      <Component Id="ProductLibUITheme">
        <File Id="WeifenLuo.WinFormsUI.Docking.ThemeVS2015.dll" Source="$(var.SuperPutty.TargetDir)\WeifenLuo.WinFormsUI.Docking.ThemeVS2015.dll" />
      </Component>
      <!-- the Classic interface theme (Options -> GUI) -->
      <Component Id="ProductLibUIThemeClassic">
        <File Id="WeifenLuo.WinFormsUI.Docking.ThemeVS2005.dll" Source="$(var.SuperPutty.TargetDir)\WeifenLuo.WinFormsUI.Docking.ThemeVS2005.dll" />
      </Component>
      <!-- reads and writes EnvironmentVariables.json; needed by every session launch ({key} placeholders) -->
      <Component Id="ProductLibJson">
        <File Id="Newtonsoft.Json.dll" Source="$(var.SuperPutty.TargetDir)\Newtonsoft.Json.dll" />
      </Component>
      <!-- Database sessions: Npgsql and the libraries it needs on .NET Framework -->
      <Component Id="ProductLibDb_Npgsql">
        <File Id="Npgsql.dll" Source="$(var.SuperPutty.TargetDir)\Npgsql.dll" />
      </Component>
      <Component Id="ProductLibDb_Microsoft_Bcl_AsyncInterfaces">
        <File Id="Microsoft.Bcl.AsyncInterfaces.dll" Source="$(var.SuperPutty.TargetDir)\Microsoft.Bcl.AsyncInterfaces.dll" />
      </Component>
      <Component Id="ProductLibDb_Microsoft_Bcl_HashCode">
        <File Id="Microsoft.Bcl.HashCode.dll" Source="$(var.SuperPutty.TargetDir)\Microsoft.Bcl.HashCode.dll" />
      </Component>
      <Component Id="ProductLibDb_Microsoft_Extensions_DependencyInjection_Abstractions">
        <File Id="Microsoft.Extensions.DependencyInjection.Abstractions.dll" Source="$(var.SuperPutty.TargetDir)\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      </Component>
      <Component Id="ProductLibDb_Microsoft_Extensions_Logging_Abstractions">
        <File Id="Microsoft.Extensions.Logging.Abstractions.dll" Source="$(var.SuperPutty.TargetDir)\Microsoft.Extensions.Logging.Abstractions.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Buffers">
        <File Id="System.Buffers.dll" Source="$(var.SuperPutty.TargetDir)\System.Buffers.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Collections_Immutable">
        <File Id="System.Collections.Immutable.dll" Source="$(var.SuperPutty.TargetDir)\System.Collections.Immutable.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Diagnostics_DiagnosticSource">
        <File Id="System.Diagnostics.DiagnosticSource.dll" Source="$(var.SuperPutty.TargetDir)\System.Diagnostics.DiagnosticSource.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Memory">
        <File Id="System.Memory.dll" Source="$(var.SuperPutty.TargetDir)\System.Memory.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Numerics_Vectors">
        <File Id="System.Numerics.Vectors.dll" Source="$(var.SuperPutty.TargetDir)\System.Numerics.Vectors.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Runtime_CompilerServices_Unsafe">
        <File Id="System.Runtime.CompilerServices.Unsafe.dll" Source="$(var.SuperPutty.TargetDir)\System.Runtime.CompilerServices.Unsafe.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Text_Encodings_Web">
        <File Id="System.Text.Encodings.Web.dll" Source="$(var.SuperPutty.TargetDir)\System.Text.Encodings.Web.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Text_Json">
        <File Id="System.Text.Json.dll" Source="$(var.SuperPutty.TargetDir)\System.Text.Json.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Threading_Channels">
        <File Id="System.Threading.Channels.dll" Source="$(var.SuperPutty.TargetDir)\System.Threading.Channels.dll" />
      </Component>
      <Component Id="ProductLibDb_System_Threading_Tasks_Extensions">
        <File Id="System.Threading.Tasks.Extensions.dll" Source="$(var.SuperPutty.TargetDir)\System.Threading.Tasks.Extensions.dll" />
      </Component>
      <Component Id="ProductLibDb_System_ValueTuple">
        <File Id="System.ValueTuple.dll" Source="$(var.SuperPutty.TargetDir)\System.ValueTuple.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Highlighted Output: the WebView2 control (the runtime itself comes with Windows) and the page it shows, from
       web\ beside the exe. The exe is AnyCPU, so WebView2's native loader is needed for each architecture. -->
  <Fragment>
    <ComponentGroup Id="HighlightedOutputComponents" Directory="INSTALLFOLDER">
      <Component Id="ProductLibWebView2Core">
        <File Id="Microsoft.Web.WebView2.Core.dll" Source="$(var.SuperPutty.TargetDir)\Microsoft.Web.WebView2.Core.dll" />
      </Component>
      <Component Id="ProductLibWebView2WinForms">
        <File Id="Microsoft.Web.WebView2.WinForms.dll" Source="$(var.SuperPutty.TargetDir)\Microsoft.Web.WebView2.WinForms.dll" />
      </Component>
      <Component Id="WebView2Loader_x64" Subdirectory="runtimes\win-x64\native">
        <File Id="WebView2Loader_x64.dll" Source="$(var.SuperPutty.TargetDir)\runtimes\win-x64\native\WebView2Loader.dll" />
      </Component>
      <Component Id="WebView2Loader_x86" Subdirectory="runtimes\win-x86\native">
        <File Id="WebView2Loader_x86.dll" Source="$(var.SuperPutty.TargetDir)\runtimes\win-x86\native\WebView2Loader.dll" />
      </Component>
      <Component Id="WebView2Loader_arm64" Subdirectory="runtimes\win-arm64\native">
        <File Id="WebView2Loader_arm64.dll" Source="$(var.SuperPutty.TargetDir)\runtimes\win-arm64\native\WebView2Loader.dll" />
      </Component>
      <Files Subdirectory="web" Include="$(var.SuperPutty.TargetDir)\web\**" />
    </ComponentGroup>
  </Fragment>
</Wix>